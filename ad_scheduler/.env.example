# Токен бота управления (от @BotFather)
BOT_TOKEN=123456:ABC-DEF

# ID администраторов через запятую
ADMIN_IDS=123456789

# SOCKS5 прокси (для РФ)
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USER=
PROXY_PASS=

# Интервал между постами в один чат (минуты)
DEFAULT_INTERVAL_MINUTES=15

# Пауза между чатами при рассылке (секунды)
POST_DELAY_SECONDS=5

# Как часто планировщик проверяет чаты (секунды)
SCHEDULER_TICK_SECONDS=15

# Автосинхронизация чатов при запуске
AUTO_SYNC_ON_START=true

# Автостарт рассылки если есть чаты и сообщение
AUTO_START_SCHEDULER=true

# Путь к базе данных
DATABASE_PATH=data/scheduler.db

# Папка для сессий Pyrogram
SESSIONS_DIR=data/sessions
