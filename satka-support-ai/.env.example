# Copy to .env and fill in values

# Telegram bot token for support AI (@satkavpnsupport or dedicated bot from @BotFather)
SUPPORT_AI_BOT_TOKEN=

# Token used to send urgent alerts to admin (can be main @satkavpn_bot token)
ALERT_BOT_TOKEN=

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Admin Telegram numeric ID (for @hustlehapp — confirm with @userinfobot)
ADMIN_CHAT_ID=8505786243
ADMIN_USERNAME=hustlehapp

# Gemini model
GEMINI_MODEL=gemini-2.0-flash

# Optional: restrict to specific chat IDs (comma-separated). Leave empty for all users.
# ALLOWED_CHAT_IDS=

MAX_HISTORY_TURNS=12
ALERT_REPEAT_COUNT=3
ALERT_REPEAT_DELAY_SEC=1.2
LOG_LEVEL=INFO
