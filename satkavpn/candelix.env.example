# Скопируйте в candelix.env и заполните секреты на сервере.

CANDELIX_URL=https://sub.cndlx.sbs/YOUR-KEY
CANDELIX_HWID=
WHITELIST_URL=https://vpn.sinful.click/YOUR-KEY
FREE_VPN_URL=https://vpn.sinful.click/YOUR-KEY
PAID_WHITELIST_SOURCE=static

# false = Candelix/sinful не видят устройства клиентов (рекомендуется)
UPSTREAM_SEND_HWID=false

SUB_INTERNAL=http://remnawave-subscription-page:3010
SUB_HOST=sub.satkaconnect.xyz
REMNAWAVE_PANEL_URL=https://panel.satkaconnect.xyz
REMNAWAVE_API_TOKEN=

BEDOLAGA_DATABASE_URL=
FREE_TOKENS_FILE=/app/free-tokens.json
WHITELIST_VLESS_FILE=/app/whitelist-vless.json
